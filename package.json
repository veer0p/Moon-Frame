{
    "name": "electron-watch-together",
    "version": "1.1.0",
    "description": "Watch videos together in real-time - Desktop App",
    "main": "electron/main.js",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"vite --host\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "electron:dev": "vite",
        "package": "npm run build && electron-builder",
        "build:win": "npm run build && electron-builder --win",
        "build:linux": "npm run build && electron-builder --linux"
    },
    "keywords": [
        "electron",
        "watch-together",
        "video",
        "sync",
        "real-time"
    ],
    "author": "Veer",
    "license": "MIT",
    "dependencies": {
        "@livekit/components-react": "^2.9.21",
        "@radix-ui/react-tabs": "^1.1.16",
        "@supabase/supabase-js": "^2.89.0",
        "agy": "^0.0.0",
        "antigravity": "^0.0.0",
        "ffmpeg-static": "^5.2.0",
        "livekit-client": "^2.19.2",
        "lucide-react": "^1.23.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vaul": "^1.1.2",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "ssh2": "^1.17.0",
        "vite": "^7.2.4",
        "vite-plugin-pwa": "^1.3.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.watchtogether.app",
        "productName": "Watch Together",
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Video"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/ffmpeg-static/**"
        ],
        "extraResources": [
            {
                "from": "node_modules/ffmpeg-static",
                "to": "ffmpeg-static",
                "filter": [
                    "ffmpeg",
                    "ffmpeg.exe"
                ]
            }
        ],
        "directories": {
            "buildResources": "assets",
            "output": "release"
        }
    }
}
